<?xml version="1.0" encoding="UTF-8"?>
<!--
  Add-in only (XML) manifest – kept deliberately for mobile-readiness (D-008, D-018).
  BASE_URL / ORIGIN / ADDIN_ID / DISPLAY_NAME placeholders (in double braces) are substituted at
  build time (webpack.config.js). Dev and production use different IDs so both can be installed.
  Mobile later: add a <MobileFormFactor> under the MailHost (read surface only).
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>{{ADDIN_ID}}</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>ITM Solutions</ProviderName>
  <DefaultLocale>en-GB</DefaultLocale>
  <DisplayName DefaultValue="{{DISPLAY_NAME}}"/>
  <Description DefaultValue="Hide an encrypted code in your signature image, and reveal codes hidden in received messages."/>
  <IconUrl DefaultValue="{{BASE_URL}}assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="{{BASE_URL}}assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://itmsolutions.co.uk/"/>
  <AppDomains>
    <AppDomain>{{ORIGIN}}</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <!-- 1.8: getAttachmentContentAsync, addFileAttachmentFromBase64Async, getAttachmentsAsync -->
      <Set Name="Mailbox" MinVersion="1.8"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{BASE_URL}}taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.8">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>

            <!-- Read: "Check message" – pinnable so it re-checks each selected message (D-007) -->
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="ostgReadGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="ostgReadButton">
                    <Label resid="ReadButton.Label"/>
                    <Supertip>
                      <Title resid="ReadButton.Label"/>
                      <Description resid="ReadButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- Compose: "Secure signature" – opens the pane to enter the secret -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="ostgComposeGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="ostgComposeButton">
                    <Label resid="ComposeButton.Label"/>
                    <Supertip>
                      <Title resid="ComposeButton.Label"/>
                      <Description resid="ComposeButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="{{BASE_URL}}assets/icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="{{BASE_URL}}assets/icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="{{BASE_URL}}assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="{{BASE_URL}}commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="{{BASE_URL}}taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="{{DISPLAY_NAME}}"/>
          <bt:String id="ReadButton.Label" DefaultValue="Check message"/>
          <bt:String id="ComposeButton.Label" DefaultValue="Secure signature"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="ReadButton.Tooltip" DefaultValue="Check this message for a hidden code. Pin the pane to check every message automatically."/>
          <bt:String id="ComposeButton.Tooltip" DefaultValue="Add your signature with a hidden, encrypted code."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
