{
  "name": "outlook-stego-addin",
  "version": "0.1.0",
  "private": true,
  "description": "Outlook web add-in: hide/reveal encrypted codes in a cursive signature image",
  "scripts": {
    "build:wasm": "node ../scripts/build-wasm.mjs",
    "build": "npm run build:wasm && webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev": "webpack serve --mode development",
    "typecheck": "tsc --noEmit",
    "deploy": "node ../scripts/deploy.mjs",
    "verify": "node ../scripts/verify-deploy.mjs",
    "pretest": "npm run build:wasm",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.0",
    "copy-webpack-plugin": "^12.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jsdom": "^25.0.1",
    "office-addin-dev-certs": "^2.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
